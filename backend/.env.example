# Copy this file to .env in the same directory (backend/) and edit.
# Everything here is optional. The simulation runs fully offline with no LLM configured.

CIVITAS_ENVIRONMENT=development
CIVITAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite is the default and verified store.
# CIVITAS_DATABASE_URL=sqlite:///C:/Users/you/civitas/backend/data/civitas.db

# Optional: require ?api_key= on WebSocket connections.
# CIVITAS_API_KEY=

# Optional manual chronicler. Never used during ticks.
# CIVITAS_LLM_ENABLED=false
# CIVITAS_LLM_BASE_URL=https://api.openai.com/v1
# CIVITAS_LLM_API_KEY=
# CIVITAS_LLM_MODEL=gpt-4o-mini

CIVITAS_SNAPSHOT_INTERVAL_DAYS=25
CIVITAS_AUTOSAVE_INTERVAL_DAYS=25
